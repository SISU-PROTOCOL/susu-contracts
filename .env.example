# susu-contracts — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# This repository holds contract source only: it must never contain private keys,
# seed phrases, or service-role credentials in tracked files.
#
# Deployment signing uses the Stellar CLI's own key store (`stellar keys`), not
# environment files. Mainnet deployment is manual and requires explicit approval.

# ---------------------------------------------------------------------------
# Network selection — Testnet only for MVP. Mainnet is out of scope until the
# Mainnet readiness gate is passed with explicit human approval.
# ---------------------------------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ---------------------------------------------------------------------------
# Public addresses only. Private keys never belong in this file.
# ---------------------------------------------------------------------------
# Deployer: pays network fees. Separate from protocol admin and treasury.
SUSU_DEPLOYER_PUBLIC=

# Protocol admin: security-sensitive authority. Testnet-only for MVP.
SUSU_ADMIN_PUBLIC=

# Treasury: dedicated fee recipient. Must never be a developer personal wallet.
SUSU_TREASURY_PUBLIC=

# ---------------------------------------------------------------------------
# Asset — Testnet USDC SAC. Verify against official Stellar docs before use.
# Mainnet USDC IDs must never be mixed with Testnet IDs.
# ---------------------------------------------------------------------------
STELLAR_TESTNET_USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
STELLAR_TESTNET_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ---------------------------------------------------------------------------
# Protocol constants — must match the contract implementation exactly.
# Changing these requires human review: they are financial invariants.
# ---------------------------------------------------------------------------
PROTOCOL_FEE_BPS=50

# ---------------------------------------------------------------------------
# Deployed contract IDs. C... addresses are public and safe to record.
# Regenerated by scripts/deploy-testnet.sh into `.env.testnet` (gitignored).
# ---------------------------------------------------------------------------
FACTORY_CONTRACT_ID=CCC7KAX4V4GJD6FVG6GSYQ4I2D2B3CWEOQMIX6YM4QBGXTA6INCGRUYC
