#!/bin/sh
#
# Fast pre-commit checks for susu-contracts.
#
# Installed by `scripts/setup-hooks.sh`; see `.githooks/commit-msg` for why the
# hooks live in `.githooks/` instead of `.git/hooks/`.
#
# Two rules govern this hook, and both matter more than coverage does:
#
#   1. It must never block someone who lacks the toolchain. No cargo, no
#      rustfmt, no check — skip with a message and let the commit through. CI
#      is what enforces the checks; this is a courtesy to the committer.
#   2. It must be fast. Nothing here compiles by default: a pre-commit hook that
#      costs minutes is bypassed with `--no-verify` and then protects nothing.
#      The test suite, clippy, the wasm build and the mainnet readiness gate are
#      CI's job.

cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || exit 0
[ -f Cargo.toml ] || exit 0

# Only Rust changes are interesting: a docs-only or scripts-only commit has
# nothing to format.
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs' 2>/dev/null)
[ -n "$staged" ] || exit 0

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found — skipping the Rust format check." >&2
  echo "pre-commit: install it from https://rustup.rs to have this check run locally." >&2
  exit 0
fi

if ! command -v rustfmt >/dev/null 2>&1; then
  echo "pre-commit: rustfmt not found — skipping the Rust format check." >&2
  echo "pre-commit: install it with 'rustup component add rustfmt'." >&2
  exit 0
fi

# `cargo fmt --all --check` is exactly what CI runs, and it is the only form
# that agrees with CI: it honours the workspace's rustfmt.toml, the `[workspace]`
# membership, and the module graph. Pointing rustfmt at individual staged files
# formats modules differently from `cargo fmt` and would report failures CI does
# not agree with. It is read-only and parses no dependencies, so it stays fast.
if ! cargo fmt --all --check; then
  echo >&2
  echo "pre-commit: formatting check failed." >&2
  echo "pre-commit: run 'cargo fmt --all', stage the result, and commit again." >&2
  exit 1
fi

# Clippy is opt-in, and off by default, because it compiles the whole dependency
# graph (soroban-sdk included) — far too slow to put in front of every commit.
# CI runs it with `-D warnings` on every push, so nothing reaches main unchecked.
# Opt in for a run with:
#
#   SUSU_PRECOMMIT_CLIPPY=1 git commit ...
if [ "${SUSU_PRECOMMIT_CLIPPY:-0}" = "1" ]; then
  if command -v cargo-clippy >/dev/null 2>&1; then
    echo "pre-commit: SUSU_PRECOMMIT_CLIPPY=1 — running clippy (this compiles the workspace)." >&2
    if ! cargo clippy --workspace --all-targets -- -D warnings; then
      echo "pre-commit: clippy failed." >&2
      exit 1
    fi
  else
    echo "pre-commit: clippy not installed (try: rustup component add clippy) — skipping." >&2
  fi
fi

exit 0
